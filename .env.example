PORT=5000
NODE_ENV=production
APP_URL=https://your-lms-domain.com
API_URL=https://api.your-lms-domain.com

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@host:port/database
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.username
DB_PASSWORD=your_password_here
DB_SSL=true

JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret_here
EMAIL_PROVIDER=resend
EMAIL_FROM=admissions@your-lms-domain.com
EMAIL_API_KEY=re_your_resend_api_key
SESSION_JOIN_WINDOW_MINUTES=15
