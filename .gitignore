# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/

# Local Environment files (Never commit secrets to git)
.env
.env.local
.env.*.local
*/.env
*/.env.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local
# Keep .env.example templates tracked (not matched by the patterns above)
!.env.example
!*/.env.example

# Local database files (contain data / live locally)
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Uploaded course materials (user content, served at runtime)
backend/uploads/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
